{
  "name": "emilda-governance-os",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local --level warning --fail-on error",
    "test:e2e:live": "LIVE_SUPABASE_E2E=1 playwright test tests/e2e/live-supabase.spec.ts --project=desktop --workers=1",
    "pdf:demo": "tsx scripts/generate-demo-pdf.tsx",
    "qa": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@hookform/resolvers": "5.2.2",
    "@react-pdf/renderer": "4.9.0",
